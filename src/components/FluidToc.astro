---
// Table of contents structure and classes migrated from tremendous-matter.
---

<aside class="sidebar fluid-toc-sidebar" aria-label="Table of contents">
  <div id="toc">
    <p class="toc-header">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" /></svg>
      <span>Table of Contents</span>
    </p>
    <div class="toc-body" id="toc-body"></div>
  </div>
</aside>

<script>
  import tocbot from 'tocbot';

  const toc = document.getElementById('toc');
  const sidebar = document.querySelector<HTMLElement>('.fluid-toc-sidebar');
  const header = document.querySelector<HTMLElement>('header.site-header');

  if (toc && sidebar) {
    const tocOptions = {
      tocSelector: '#toc-body',
      contentSelector: '#board .markdown-body',
      headingSelector: 'h1, h2, h3, h4, h5, h6',
      hasInnerContainers: true,
      linkClass: 'tocbot-link',
      activeLinkClass: 'tocbot-active-link',
      listClass: 'tocbot-list',
      isCollapsedClass: 'tocbot-is-collapsed',
      collapsibleClass: 'tocbot-is-collapsible',
      scrollSmooth: !window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      includeTitleTags: true,
    };
    let previousOffset = 0;
    const updateOffset = () => {
      // Height stays stable while the navigation slides out of view.
      const headerOffset = (header?.offsetHeight ?? 64) + 20;
      if (headerOffset === previousOffset) return;
      previousOffset = headerOffset;
      sidebar.style.setProperty('--toc-top', `${headerOffset}px`);
      document.documentElement.style.setProperty('--article-heading-offset', `${headerOffset}px`);
      tocbot.refresh({ ...tocOptions, headingsOffset: headerOffset, scrollSmoothOffset: -headerOffset });
    };
    updateOffset();
    if (header) new ResizeObserver(updateOffset).observe(header);

    if (toc.querySelector('.toc-list-item')) {
      toc.style.visibility = 'visible';
    } else {
      sidebar.hidden = true;
    }
  }
</script>

<style>
  .fluid-toc-sidebar { position: sticky; top: var(--toc-top, 84px); padding: 3rem 0; }
  .toc-header { display: flex; align-items: center; gap: 8px; margin: 0 0 .5rem; font-size: 1.25rem; font-weight: 600; line-height: 1.2; color: #d4d8df; }
  .toc-header svg { flex-shrink: 0; width: 20px; height: 20px; margin: 0; color: inherit; }
  .toc-body { max-height: calc(100svh - var(--toc-top, 84px) - 80px); }
  #toc :global(.tocbot-list) { margin-block: 0; }
  #toc :global(.toc-list-item) { line-height: 1.8; }
  #toc :global(.tocbot-link) { color: #a9afb9; font-size: .95rem; }
  #toc :global(.tocbot-link:hover),
  #toc :global(.tocbot-active-link) { color: #e4edf7; }
  #toc :global(.toc-list-item::before) { background: #b7cfe7; }
  #toc :global(.tocbot-link:focus-visible) { outline: 2px solid #b7cfe7; outline-offset: -2px; }
</style>
