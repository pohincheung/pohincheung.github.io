---
import type {CollectionEntry} from 'astro:content';
const {posts} = Astro.props as {posts:CollectionEntry<'posts'>[]};
---
<div class="post-list">{posts.length?posts.map(post=><a class="post" href={`/posts/${post.id}/`} aria-label={post.data.title}><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="tags">{post.data.tags.join(' / ')}</span></div><span aria-hidden="true">↗</span></a>):<div class="empty"><p>No posts yet.</p><span>A little space for what comes next.</span></div>}</div>

<style>
  .post { width: 100%; cursor: pointer; text-decoration: none; }
  .post:focus-visible { outline: 2px solid #d4d8df; outline-offset: 5px; border-radius: 6px; }
</style>
