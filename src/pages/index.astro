---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';
import { comparePosts } from '../lib/posts';

const posts = (await getCollection('posts', ({ data }) => !data.example)).sort(comparePosts);
---

<Layout>
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <img class="hero-photo" src="/images/cover.webp" alt="" width="1920" height="1080" fetchpriority="high" />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-soften" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 id="home-title">PohinCheung’s <em>Blog<span>.</span></em></h1>
        <p class="hero-description">Notes on reading, research, and everyday life.</p>
      </div>
    </section>

    <section id="notes" class="reading-space" aria-labelledby="notes-title">
      <div class="content-wrap">
        <div class="main-column">
          <div class="section-heading">
            <div>
              <p class="section-eyebrow">A space for ideas</p>
              <h2 id="notes-title">Notes & Essays</h2>
            </div>
            <a class="all-posts" href="/writing/">All posts <span aria-hidden="true">↗</span></a>
          </div>
          <div class="article-list">
            {posts.map(post => (
              <a class="home-post entry-link" href={`/posts/${post.id}/`} aria-label={post.data.title}>
                  <div class="entry-meta">
                    {post.data.pinned && <span>Pinned</span>}
                    <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
                    <span>{categories.find(({id}) => id === post.data.category)?.title}</span>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p class="entry-description">{post.data.description}</p>
                  <span class="entry-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
            {posts.length === 0 && <p class="empty-state">New writing is on its way.</p>}
          </div>
        </div>

      </div>
    </section>
  </div>
</Layout>

<style>
  .home-page {
    --paper: #111c2b;
    --ink: #eceef1;
    --muted: #a9afb9;
    --accent: #d4d8df;
    background: var(--paper);
    color: var(--ink);
  }
  .home-page a { text-decoration: none; }
  .home-page a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }

  /* Keep the original skyline clear, with progressively softer edges. */
  .hero { position: relative; isolation: isolate; height: 90svh; min-height: 660px; max-height: 1080px; overflow: hidden; }
  .hero-photo, .hero-shade, .hero-soften { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero-photo { z-index: -3; object-fit: cover; object-position: center; }
  .hero-shade { z-index: -2; background: linear-gradient(180deg, #111c2b4d 0%, #111c2b18 32%, #111c2b42 61%, #111c2bcc 88%, #111c2b 100%); }
  .hero-soften {
    z-index: -1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask-image: linear-gradient(#0009 0%, transparent 30%, transparent 57%, #000 93%);
    -webkit-mask-image: linear-gradient(#0009 0%, transparent 30%, transparent 57%, #000 93%);
  }
  .hero-content { position: absolute; top: 45%; left: 24px; right: 24px; transform: translateY(-50%); text-align: center; }
  .hero-content::before { content: ''; position: absolute; z-index: -1; inset: -48px 15%; border-radius: 50%; background: #111c2b32; filter: blur(44px); pointer-events: none; }
  h1 { margin: 0; color: #eceef1; font-size: clamp(36px, 5.2vw, 72px); font-weight: 500; line-height: 1.2; letter-spacing: -.045em; text-shadow: 0 4px 36px #111c2b55; }
  h1 em { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
  h1 em span { color: #d4d8df; }
  .hero-description { margin: 26px 0 0; color: #d4d8df; font-size: 15px; letter-spacing: .025em; }

  /* Ambient color from the same image sits behind a borderless reading surface. */
  .reading-space { position: relative; isolation: isolate; margin-top: -70px; padding: 0 32px 80px; scroll-margin-top: 130px; }
  .reading-space::before { content: ''; position: absolute; z-index: -1; inset: -30px 7% 15%; background: url('/images/cover.webp') center 70% / cover; opacity: .16; filter: blur(70px); border-radius: 40%; pointer-events: none; }
  .content-wrap {
    width: min(920px, 100%);
    margin: 0 auto;
    padding: 46px 44px 44px;
    display: block;
    border-radius: 30px;
    background: linear-gradient(140deg, #192a40a6, #192a4038 65%, #192a4055);
    box-shadow: 0 16px 60px #070e1717;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }
  .main-column { min-width: 0; }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
  .section-eyebrow { margin: 0 0 9px; color: var(--muted); font-size: 11px; letter-spacing: .12em; }
  .section-heading h2 { margin: 0; color: var(--ink); font-size: 24px; font-weight: 500; letter-spacing: .03em; }
  .all-posts { padding-block: 6px; font-size: 12px; white-space: nowrap; }
  .all-posts span { margin-left: 6px; }
  .article-list { display: grid; gap: 12px; }
  .home-post { position: relative; min-width: 0; }
  .entry-link { position: relative; display: block; width: 100%; padding: 28px 50px 28px 26px; border-radius: 18px; background: #b7cfe708; cursor: pointer; transition: background .25s ease, transform .25s ease; }
  .entry-link:is(:hover, :focus-visible) { background: #b7cfe711; transform: translateY(-2px); }
  .entry-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-bottom: 13px; font-size: 11px; color: var(--muted); }
  .entry-meta time { font-size: inherit; font-variant-numeric: tabular-nums; }
  .entry-meta > span { background: #9bc1e50b; padding: 2px 8px; border-radius: 6px; }
  .entry-link h3 { margin: 0; color: var(--ink); font-size: 20px; line-height: 1.6; font-weight: 500; overflow-wrap: anywhere; }
  .entry-description { margin: 12px 0 0; color: var(--muted); font-size: 14px; line-height: 1.9; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }
  .entry-arrow { position: absolute; top: 30px; right: 23px; color: var(--muted); font-size: 17px; opacity: .65; transition: transform .25s ease, opacity .25s ease; }
  .entry-link:is(:hover, :focus-visible) .entry-arrow { opacity: 1; transform: translate(2px, -2px); }
  .empty-state { color: var(--muted); font-size: 14px; padding-block: 24px; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .content-wrap { background: #192a40; }
  }
  @media (min-width: 1600px) { .hero-content { top: 47%; } }
  @media (max-width: 1000px) {
    .content-wrap { padding: 36px 30px; }
  }
  @media (max-width: 760px) {
    .hero { height: 88svh; min-height: 620px; max-height: 900px; }
    .hero-content { top: 46%; left: 20px; right: 20px; }
    h1 { font-size: clamp(32px, 7vw, 50px); }
    h1 em { display: block; margin-top: 8px; font-size: 1.2em; }
    .hero-description { font-size: 12px; letter-spacing: .06em; margin-top: 22px; }
    .reading-space { padding: 0 18px 48px; margin-top: -62px; scroll-margin-top: 155px; }
    .content-wrap { display: block; padding: 30px 24px; border-radius: 24px; }
    .section-heading { margin-bottom: 24px; gap: 10px; }
    .section-heading h2 { font-size: 21px; }
    .section-eyebrow { font-size: 10px; }
    .all-posts { font-size: 11px; }
    .entry-link { padding: 22px 34px 22px 18px; border-radius: 14px; }
    .entry-link h3 { font-size: 18px; }
    .entry-description { font-size: 13px; }
    .entry-arrow { top: 25px; right: 14px; font-size: 14px; }
  }
  @media (max-width: 370px) {
    .content-wrap { padding: 26px 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; }
    .entry-link:is(:hover, :focus-visible), .entry-link:is(:hover, :focus-visible) .entry-arrow { transform: none; }
  }
</style>
