---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import {getCollection} from 'astro:content';
import { comparePosts } from '../lib/posts';
const posts=(await getCollection('posts', ({data}) => !data.example)).sort(comparePosts);
const pinnedPosts=posts.filter(p=>p.data.pinned);
const datedPosts=posts.filter(p=>!p.data.pinned);
const years=[...new Set(datedPosts.map(p=>p.data.date.getUTCFullYear()))];
---
<Layout title="Posts">
  <section class="page-heading"><h1>Posts</h1></section>
  {pinnedPosts.length > 0 && <section class="pinned-posts"><h2>Pinned</h2><PostList posts={pinnedPosts}/></section>}
  {years.map(year=><section><h2>{year}</h2><PostList posts={datedPosts.filter(p=>p.data.date.getUTCFullYear()===year)}/></section>)}
</Layout>

<style>
  .pinned-posts { margin-bottom: 36px; }
</style>
