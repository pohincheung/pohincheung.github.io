---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('posts', ({data}) => !data.example)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const years=[...new Set(posts.map(p=>p.data.date.getUTCFullYear()))];
---
<Layout title="Posts"><section class="page-heading"><h1>Posts</h1></section>{years.map(year=><section><h2>{year}</h2><PostList posts={posts.filter(p=>p.data.date.getUTCFullYear()===year)}/></section>)}</Layout>
