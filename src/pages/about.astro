---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About" description="Exploring AI systems, quantitative research, and DeFi. Open to research collaborations, open source, and exchanging ideas.">
  <div class="about-page">
    <section class="profile-intro" aria-labelledby="about-title">
      <div class="profile-copy">
        <p class="profile-eyebrow">ABOUT / POHINCHEUNG</p>
        <h1 id="about-title">Code, markets<br />&amp; <em>curiosity.</em></h1>
        <p class="profile-description">Exploring AI systems, quantitative research, and DeFi. Learning through papers, code, and small experiments.</p>
        <div class="connect-row">
          <div class="social-links" aria-label="Contact and social profiles">
            <a href="https://github.com/pohincheung" target="_blank" rel="noopener noreferrer" aria-label="PohinCheung on GitHub (opens in a new tab)" title="GitHub · @pohincheung">
              <svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
            </a>
            <a href="https://x.com/PohinCheung" target="_blank" rel="noopener noreferrer" aria-label="PohinCheung on X (opens in a new tab)" title="X · @PohinCheung">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932 6.064-6.933Zm-1.29 19.49h2.039L6.486 3.24H4.298l13.313 17.403Z" /></svg>
            </a>
            <a href="mailto:pohincheung2004@gmail.com" aria-label="Email PohinCheung at pohincheung2004@gmail.com" title="Email · pohincheung2004@gmail.com">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
            </a>
          </div>
          <p class="collaboration-note"><span aria-hidden="true"></span>Open to collaboration</p>
        </div>
      </div>
      <div class="portrait">
        <div class="portrait-frame">
          <img src="/images/avatar.png" alt="A fluffy cat peeking around a door" width="602" height="576" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="interest-grid" aria-label="What I’m interested in">
      <div class="interest">
        <p class="interest-label">BUILD & UNDERSTAND</p>
        <h2>AI & software</h2>
        <p class="interest-description">Software reliability, compilers, GPU kernels, and fuzz testing. Understanding where systems fail, and making the results reproducible.</p>
      </div>
      <div class="interest">
        <p class="interest-label">QUESTION & EXPERIMENT</p>
        <h2>Quant & DeFi</h2>
        <p class="interest-description">Market microstructure, arbitrage, options, and volatility. Curious about how markets work, with a close eye on assumptions and real trading costs.</p>
      </div>
      <div class="interest">
        <p class="interest-label">READ & EXPLORE</p>
        <h2>Beyond the screen</h2>
        <p class="interest-description">Economics and history, exercise and travel. Making room for ideas and experiences that change how I see the world.</p>
      </div>
    </section>

    <div class="closing-note">
      <p>A notebook, <em>always in progress.</em></p>
      <span>What I read, what I try, and what I learn along the way.</span>
    </div>
  </div>
</Layout>

<style>
  .about-page { padding: 12px 4px 0; }
  .profile-intro { display: grid; grid-template-columns: minmax(0, 1fr) 290px; align-items: center; gap: 64px; }
  .profile-copy { min-width: 0; }
  .profile-eyebrow { margin: 0 0 24px; color: #a9afb9; font-size: 10px; letter-spacing: .19em; }
  .profile-copy h1 { margin: 0; color: #eceef1; font-size: clamp(44px, 4.5vw, 60px); line-height: 1.12; font-weight: 500; letter-spacing: -.045em; }
  .profile-copy h1 em { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; color: var(--page-accent, #d4d8df); }
  .profile-description { max-width: 410px; margin: 24px 0 0; color: #b5bbc4; font-size: 15px; line-height: 1.9; }
  .portrait { position: relative; isolation: isolate; width: 280px; justify-self: end; }
  .portrait::before { content: ''; position: absolute; z-index: -1; inset: -30px; border-radius: 50%; background: #b7cfe71c; filter: blur(45px); pointer-events: none; }
  .portrait-frame { aspect-ratio: 1; overflow: hidden; border-radius: 50%; box-shadow: 0 18px 54px #070e1740, 0 0 0 8px #e4edf704; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .connect-row { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; margin-top: 28px; }
  .social-links { display: flex; align-items: center; gap: 10px; }
  .social-links a { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: #b7cfe70d; transition: background .2s ease, transform .2s ease; }
  .social-links a:hover { background: #b7cfe71c; transform: translateY(-2px); }
  .social-links svg { display: block; width: 21px; height: 21px; margin: 0; color: inherit; }
  .collaboration-note { display: flex; align-items: center; gap: 8px; margin: 0; color: #b5bbc4; font-size: 11px; }
  .collaboration-note span { width: 5px; height: 5px; border-radius: 50%; background: #c4c8d0; box-shadow: 0 0 10px #c4c8d035; }
  .interest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; margin-top: 68px; }
  .interest-label { margin: 0 0 14px; color: #a9afb9; font-size: 9px; letter-spacing: .14em; }
  :global(body.content-page .inner-board) .interest h2 { margin: 0; color: var(--page-ink, #eceef1); font-size: 19px; font-weight: 500; letter-spacing: -.02em; }
  .interest-description { margin: 12px 0 0; color: #a9afb9; font-size: 13px; line-height: 1.9; }
  .closing-note { position: relative; isolation: isolate; margin-top: 42px; padding: 30px 24px; border-radius: 20px; text-align: center; background: linear-gradient(110deg, #b7cfe703, #b7cfe70a 50%, #b7cfe703); }
  .closing-note p { margin: 0 0 8px; color: #d4d8df; font-size: 21px; line-height: 1.5; letter-spacing: -.025em; font-weight: 400; }
  .closing-note em { font-family: Georgia, 'Times New Roman', serif; }
  .closing-note span { color: #a9afb9; font-size: 12px; line-height: 1.8; }
  @media (max-width: 1000px) {
    .profile-intro { grid-template-columns: minmax(0, 1fr) 240px; gap: 40px; }
    .portrait { width: 230px; }
    .interest-grid { gap: 24px; }
  }
  @media (max-width: 760px) {
    .about-page { padding: 8px 0 0; }
    .profile-intro { grid-template-columns: minmax(0, 1fr); gap: 36px; text-align: center; }
    .portrait { grid-row: 1; justify-self: center; width: 200px; }
    .profile-eyebrow { margin-bottom: 20px; font-size: 9px; }
    .profile-copy h1 { font-size: clamp(36px, 8vw, 52px); }
    .profile-description { max-width: 380px; margin: 22px auto 0; font-size: 14px; }
    .connect-row { justify-content: center; column-gap: 14px; row-gap: 12px; margin-top: 24px; }
    .interest-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; margin-top: 46px; }
    .interest-label { margin-bottom: 8px; }
    .interest-description { max-width: 48ch; margin-top: 8px; }
    .closing-note { margin-top: 32px; padding: 24px 16px; }
    .closing-note p { font-size: 20px; }
  }
  @media (max-width: 370px) {
    .portrait { width: 180px; }
    .connect-row { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-links a { transition: none; }
    .social-links a:hover { transform: none; }
  }
</style>
