---
import {getCollection,render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/FluidArticleHero.astro';
import Board from '../../components/FluidArticleBoard.astro';
export async function getStaticPaths(){return (await getCollection('posts')).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
---
<Layout title={post.data.title} description={post.data.description}><Hero title={post.data.title} author="PohinCheung" heroImageUrl="/images/cover.webp" dateLine={post.data.date.toISOString().slice(0,10)} datetimeAttr={post.data.date.toISOString()} wordsLabel={post.data.example?'格式示例 · 非个人经历':post.data.tags.join(' / ')} readMinutes={Math.max(1,Math.ceil((post.body?.length ?? 0)/400))}/><Board seoTitle={post.data.title}><p class="tags">{post.data.tags.join(' / ')}</p><Content/><p><a href={`/${post.data.category}/`}>← 返回文章列表</a></p></Board></Layout>
<style is:global>
body:has(.fluid-post-page) main{width:100%;max-width:none;padding:0}.fluid-banner{background-size:cover;background-position:center;height:60vh;min-height:340px}.full-bg-img,.fluid-post-banner-mask{height:100%}.fluid-post-banner-mask{display:flex;align-items:center;justify-content:center;color:white;text-align:center}.fluid-post-banner-h2{font-size:32px;font-weight:600;padding:0 24px}.fluid-post-banner-text .post-meta{color:white;font-size:14px;margin:0 8px}.fluid-board-outer{max-width:1100px;margin:-35px auto 60px;position:relative;padding:0 24px}.fluid-board-center{width:100%}#board{background:white;border-radius:8px;box-shadow:0 8px 24px #20334c14;padding:45px 55px}.post-content{max-width:850px;margin:auto}.markdown-body{font-size:16px;line-height:2;color:#2c3e50}.markdown-body h2{margin:32px 0 18px;border-bottom:1px solid #eaecef;padding-bottom:10px}.markdown-body img{max-width:100%;height:auto}.markdown-body code{background:#f6f8fa;padding:3px 6px;font-size:14px;overflow-wrap:anywhere}#seo-header{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden}.fluid-side-spacer,.fluid-toc-col{display:none}@media(max-width:600px){#board{padding:28px 22px}.fluid-board-outer{padding:0 12px}.fluid-post-banner-h2{font-size:25px}.fluid-banner{min-height:370px}}
</style>