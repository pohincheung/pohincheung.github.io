---
import {getCollection,render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/FluidArticleHero.astro';
import Board from '../../components/FluidArticleBoard.astro';
export async function getStaticPaths(){return (await getCollection('posts')).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content,headings}=await render(post);
---
<Layout title={post.data.title} description={post.data.description}><Hero title={post.data.title} author="PohinCheung" heroImageUrl="/images/cover.webp" dateLine={post.data.date.toISOString().slice(0,10)} datetimeAttr={post.data.date.toISOString()} wordsLabel={post.data.example?'格式示例 · 非个人经历':post.data.tags.join(' / ')} readMinutes={Math.max(1,Math.ceil((post.body?.length ?? 0)/400))}/><Board seoTitle={post.data.title}><p class="tags">{post.data.tags.join(' / ')}</p><Content/><p><a href={`/${post.data.category}/`}>← 返回文章列表</a></p>{headings.length > 0 && <nav slot="toc" class="article-toc" aria-label="文章目录"><strong>目录</strong><ul>{headings.map(({slug,text,depth}) => <li style={{paddingInlineStart: `${Math.max(0, depth - 2) * 12}px`}}><a href={`#${slug}`}>{text}</a></li>)}</ul></nav>}</Board></Layout>
<style is:global>
body:has(.fluid-post-page) main{width:100%;max-width:none;padding:0}.fluid-banner{background-size:cover;background-position:center;height:60vh;min-height:340px}.full-bg-img,.fluid-post-banner-mask{height:100%}.fluid-post-banner-mask{display:flex;align-items:center;justify-content:center;color:white;text-align:center}.fluid-post-banner-h2{font-size:32px;font-weight:600;padding:0 24px}.fluid-post-banner-text .post-meta{color:white;font-size:14px;margin:0 8px}.fluid-board-outer{max-width:1100px;margin:-35px auto 60px;position:relative;padding:0 24px}.fluid-board-center{width:100%}#board{background:white;border-radius:8px;box-shadow:0 8px 24px #20334c14;padding:45px 55px}.post-content{max-width:850px;margin:auto}.markdown-body{font-size:16px;line-height:2;color:#2c3e50}.markdown-body h2{margin:32px 0 18px;border-bottom:1px solid #eaecef;padding-bottom:10px}.markdown-body img{max-width:100%;height:auto}.markdown-body code{background:#f6f8fa;padding:3px 6px;font-size:14px;overflow-wrap:anywhere}#seo-header{position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden}.fluid-side-spacer{display:none}.fluid-toc-col{display:block}@media(max-width:600px){#board{padding:28px 22px}.fluid-board-outer{padding:0 12px}.fluid-post-banner-h2{font-size:25px}.fluid-banner{min-height:370px}}

.fluid-board-outer > .row { display: grid; grid-template-columns: minmax(0,1fr) minmax(140px, 19%); gap: 24px; }
.article-toc { position: sticky; top: 110px; display: block; padding: 20px 0; font-size: 14px; }
.article-toc ul { padding: 0; margin: 8px 0; list-style: none; }
.article-toc a { color: #284e79 !important; }
@media(max-width:760px) {
  .fluid-board-outer > .row { grid-template-columns: minmax(0,1fr); gap: 10px; }
  .fluid-toc-col { grid-row: 1; background: white; border-radius: 8px; padding: 0 16px; }
  .article-toc { position: static; }
}
</style>