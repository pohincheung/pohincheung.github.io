---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
const {title='首页',description='阅读、投资与日常的个人记录。'}=Astro.props;

const inner = Astro.url.pathname !== "/" && !Astro.url.pathname.startsWith("/posts/");
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/>{Astro.url.pathname.startsWith('/posts/') && <link rel="stylesheet" href="/styles/original.css"/>}<meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><title>{title} · PohinCheung</title></head><body class:list={[Astro.url.pathname==='/' && 'home']}><a class="skip" href="#main">跳到正文</a><SiteHeader overlay/><main id="main" class:list={{"fluid-inner":inner}}>{inner && <div class="inner-cover" aria-hidden="true"></div>}<div class:list={{"inner-board":inner}}><slot/></div></main><footer><span>© {new Date().getFullYear()} PohinCheung</span><span>保持好奇，留下记录。</span></footer></body></html>