---
import '../styles/global.css';
import '../styles/site-pages.css';
import '../styles/theme.css';
import SiteHeader from '../components/SiteHeader.astro';
const {title='Home',description='Notes on reading, quantitative research, and everyday life.',classic=false}=Astro.props;

const inner = Astro.url.pathname !== "/" && !Astro.url.pathname.startsWith("/posts/");
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="UTF-8"/>{Astro.url.pathname.startsWith('/posts/') && <link rel="stylesheet" href="/styles/original.css"/>}<meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" type="image/png" href="/images/avatar.png"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><title>{title} · PohinCheung</title></head><body class:list={['site-shell', Astro.url.pathname==='/' && 'home', inner && !classic && 'content-page', inner && classic && 'classic-page']}><a class="skip" href="#main">Skip to content</a><SiteHeader overlay/><main id="main" class:list={{"fluid-inner":inner}}>{inner && <div class="inner-cover" aria-hidden="true"></div>}<div class:list={{"inner-board":inner}}><slot/></div></main><footer><span>© {new Date().getFullYear()} PohinCheung</span><span>Stay curious. Keep a record.</span></footer></body></html>
